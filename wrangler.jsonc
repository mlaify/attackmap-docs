{
  // docs.matthewd.xyz — MkDocs Material, served as Workers static assets.
  //
  // There is deliberately no `main` and no Worker script. With `assets` and no
  // `main`, requests are served entirely by Cloudflare's asset worker: no
  // Worker invocation, no per-request cost, nothing to keep warm.
  //
  // Build and deploy are driven by Workers Builds (Cloudflare clones the repo
  // and runs the build itself) — see README.md. There is no GitHub Actions
  // deploy any more, and no rsync.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docs-matthewd-xyz",
  "compatibility_date": "2026-07-28",

  "assets": {
    "directory": "./site",

    // MkDocs emits site/<path>/index.html, so /install must redirect to
    // /install/. This reproduces what GitHub Pages did implicitly and what
    // LiteSpeed's DirectorySlash did on InterServer.
    "html_handling": "auto-trailing-slash",

    // MkDocs builds site/404.html. This serves it with a real 404 status.
    // Must NOT be "single-page-application" — that would return 200 for every
    // missing path and let soft-404s into the index.
    "not_found_handling": "404-page"
  },

  "routes": [
    {
      "pattern": "docs.matthewd.xyz",
      "custom_domain": true
    }
  ],

  // No <name>.workers.dev hostname for production — the docs are only
  // reachable at their custom domain, so there is no unbranded duplicate for
  // crawlers to find. Preview URLs stay on so branch builds are reviewable.
  "workers_dev": false,
  "preview_urls": true,

  "observability": {
    "enabled": true
  }
}
